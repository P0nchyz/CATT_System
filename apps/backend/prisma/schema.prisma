// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// connect-pg-simple
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// @socket.io/postgres-adapter
model SocketIOAttachment {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  payload   Bytes

  @@map("socket_io_attachment")
}

model AltchaUsedChallenge {
  signature String   @id
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("altcha_used_challenge")
}

model ProcessedJob {
  jobId       String   @id @map("job_id")
  queue       String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_jobs")
}

// --- Provisional ---
// ----------------------------------------------------------------------------
// Domain
// ----------------------------------------------------------------------------

enum AccountType {
  CAPITAL_HUMANO
  PERSONAL_CATT
  PROFESOR
  DIRECTOR_EXTERNO
  ALUMNO

  @@map("account_type")
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("account_status")
}

model Account {
  id     String        @id @default(uuid(7)) @db.Uuid
  type   AccountType // One inmutable account type per account
  status AccountStatus @default(PENDING_VERIFICATION)

  username        String    @unique @db.Citext
  email           String    @db.Citext // Not unique because of the possibility of having multiple accounts with the same email but different account types (e.g., a profesor is also an capital humano)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastAuthAt      DateTime? @map("last_auth_at") @db.Timestamptz(6)

  person      Person?
  emails      ContactEmail[]
  phones      ContactPhone[]
  socialLinks Json?          @map("social_links")

  credential Credential?

  // Account audit information
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6) // Soft delete

  // Account profile relations
  capitalHumanoProfile   CapitalHumanoProfile?
  personalCattProfile    PersonalCattProfile?
  profesorProfile        ProfesorProfile?
  directorExternoProfile DirectorExternoProfile?
  alumnoProfile          AlumnoProfile?

  @@unique([id, type])
  @@unique([email, type])
  @@index([type, status])
  @@index([deletedAt])
  @@map("accounts")
}

model Person {
  accountId      String  @id @map("account_id") @db.Uuid
  firstName      String  @map("first_name")
  middleName     String? @map("middle_name")
  lastName       String  @map("last_name")
  secondLastName String? @map("second_last_name")
  preferredName  String? @map("preferred_name")

  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  nationality String?   @map("nationality")

  curp String? @map("curp")
  rfc  String? @map("rfc")

  avatarUrl String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([lastName, secondLastName, firstName])
  @@index([curp])
  @@map("persons")
}

model ContactEmail {
  id         String    @id @default(uuid(7)) @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  email      String    @db.Citext
  label      String
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("contact_emails")
}

model ContactPhone {
  id        String   @id @default(uuid(7)) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  phone     String
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("contact_phones")
}

model CapitalHumanoProfile {
  accountId      String      @id @map("account_id") @db.Uuid
  accountType    AccountType @default(CAPITAL_HUMANO) @map("account_type")
  numeroEmpleado String      @unique @map("numero_empleado")

  account Account @relation(fields: [accountId, accountType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)

  @@unique([accountId, accountType])
  @@map("capital_humano_profiles")
}

model PersonalCattProfile {
  accountId      String      @id @map("account_id") @db.Uuid
  accountType    AccountType @default(PERSONAL_CATT) @map("account_type")
  numeroEmpleado String      @unique @map("numero_empleado")

  account Account @relation(fields: [accountId, accountType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)

  @@unique([accountId, accountType])
  @@map("personal_catt_profiles")
}

model ProfesorProfile {
  accountId      String      @id @map("account_id") @db.Uuid
  accountType    AccountType @default(PROFESOR) @map("account_type")
  numeroEmpleado String      @unique @map("numero_empleado")
  academias      Academia[]

  account Account @relation(fields: [accountId, accountType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)

  @@unique([accountId, accountType])
  @@map("profesor_profiles")
}

model DirectorExternoProfile {
  accountId   String      @id @map("account_id") @db.Uuid
  accountType AccountType @default(DIRECTOR_EXTERNO) @map("account_type")

  cvUrl                String @map("cv_url")
  cedulaProfesionalUrl String @map("cedula_profesional_url")
  cedulaProfesional    String @map("cedula_profesional")

  account Account @relation(fields: [accountId, accountType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)

  @@unique([accountId, accountType])
  @@map("director_externo_profiles")
}

model AlumnoProfile {
  accountId    String      @id @map("account_id") @db.Uuid
  accountType  AccountType @default(ALUMNO) @map("account_type")
  numeroBoleta String      @unique @map("numero_boleta")

  protocoloId String?    @map("protocolo_id") @db.Uuid
  protocolo   Protocolo? @relation(fields: [protocoloId], references: [id])

  account Account @relation(fields: [accountId, accountType], references: [id, type], onDelete: Cascade, onUpdate: Restrict)

  @@unique([accountId, accountType])
  @@index([protocoloId])
  @@map("alumno_profiles")
}

model Academia {
  id         String            @id @default(uuid(7)) @db.Uuid
  nombre     String            @unique
  profesores ProfesorProfile[]

  @@map("academias")
}

model Protocolo {
  id String @id @default(uuid(7)) @db.Uuid

  title             String
  noTrabajoTerminal String @unique @map("no_trabajo_terminal")
  summary           String

  fileUrl String @map("file_url")

  integrantes AlumnoProfile[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("protocolos")
}

model Credential {
  accountId           String    @id @map("account_id") @db.Uuid
  passwordHash        String    @map("password_hash") // Argon2id hash
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastUsedAt          DateTime? @map("last_used_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model AuditLog {
  seq          BigInt   @id @default(autoincrement())
  actorId      String   @map("actor_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  metadata     Json?
  previousHash String?  @map("previous_hash")
  hash         String   @unique
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_log")
}
